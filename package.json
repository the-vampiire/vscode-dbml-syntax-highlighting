{
  "name": "dbml-syntax-highlighting",
  "displayName": "DBML Syntax Highlighting",
  "description": "Syntax highlighting for DBML files",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.0.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dbml",
        "aliases": [
          "DBML"
        ],
        "extensions": [
          ".dbml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dbml",
        "scopeName": "source.dbml",
        "path": "./syntaxes/dbml.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish",
    "check-for-update": "bash scripts/check-for-update.sh",
    "update": "bash scripts/update.sh"
  },
  "devDependencies": {
    "vsce": "^2.0.0"
  }
}